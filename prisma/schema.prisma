// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============= ENUMS =============

enum UserRole {
  SUPER_ADMIN
  GENERAL_MANAGER
  AGENCY_MANAGER
  NORMAL_USER
  ORGANIZATION_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum TicketStatus {
  DRAFT
  COMPLETED
  FINALIZED
  INVOICED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD_READER
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  FORWARDED
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RegistrationRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
  DEMO_CREATED
}

enum BankCardStatus {
  ACTIVE
  INACTIVE
}

enum AirportType {
  INTERNATIONAL
  DOMESTIC
  BORDER
  PRIVATE
  UNDER_CONSTRUCTION
}

enum AgeType {
  ADT
  CHD
  INF
}

enum Gender {
  MALE
  FEMALE
}

enum SalesType {
  STANDARD
  REFUND
  EXCHANGE
}

enum TicketTransactionType {
  TICKET
  CREDIT
  REFUND
}

enum SupportSenderType {
  AGENCY
  ORGANIZATION
  USER
  SYSTEM
}

// ============= مدل فرودگاه‌ها =============
model Airport {
  id          String      @id @default(uuid())
  iataCode    String      @unique
  icaoCode    String?     @unique
  name        String
  city        String
  province    String
  country     String      @default("IRAN")
  timezone    String?     @default("Asia/Tehran")
  type        AirportType @default(DOMESTIC)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // روابط
  originTickets      Ticket[] @relation("OriginAirport")
  destinationTickets Ticket[] @relation("DestinationAirport")

  @@index([iataCode])
  @@index([city])
  @@index([province])
  @@index([type])
}

// ============= مدل شرکت هواپیمایی (جدید) =============
model Airline {
  id          String   @id @default(uuid())
  iataCode    String   @unique
  icaoCode    String?  @unique
  name        String
  country     String?  @default("IRAN")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]

  @@index([iataCode])
  @@index([name])
}

// ============= مدل‌های اصلی =============

model Plan {
  id                  String   @id @default(uuid())
  name                String   @unique
  description         String?
  priceMonthly        Float
  priceYearly         Float
  maxNormalUsers      Int      @default(5)
  maxAgencyManagers   Int      @default(2)
  maxTicketsPerMonth  Int?     @default(100)
  maxInvoicesPerMonth Int?     @default(50)
  features            Json?    // ساختار: { "hasAPI": true, "hasSupport": true, "hasReport": true }
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agencyPlans AgencyPlan[]
}

model Agency {
  id                 String       @id @default(uuid())
  name               String       @unique
  registrationNumber String?      @unique
  phone              String?
  email              String?      @unique
  address            String?
  iataCode           String?      @unique
  status             AgencyStatus @default(TRIAL)
  trialExpiresAt     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users                User[]
  bankCards            BankCard[]
  invoices             Invoice[]
  tickets              Ticket[]
  payments             Payment[]
  agencyPlans          AgencyPlan[]
  supportTickets       SupportTicket[]
  activityLogs         ActivityLog[]
  penalties            Penalty[]
  registrationRequests RegistrationRequest[]

  @@index([status])
  @@index([iataCode])
}

model AgencyPlan {
  id        String    @id @default(uuid())
  agencyId  String
  planId    String
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@unique([agencyId, planId, startDate])
  @@index([agencyId, isActive])
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            UserRole
  status          UserStatus @default(ACTIVE)
  agencyId        String?
  organizationId  String?
  agentIATACode   String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agency       Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  tickets              Ticket[]
  supportTickets       SupportTicket[]
  supportTicketReplies SupportTicketReply[]
  activityLogs         ActivityLog[]
  penalties            Penalty[]
  refreshTokens        RefreshToken[]
  organizationMembers  OrganizationMember[]

  @@unique([agencyId, email])
  @@index([role])
  @@index([status])
}

// ============= مدل سازمان با نقش‌ها (بهبود یافته) =============
model Organization {
  id             String    @id @default(uuid())
  name           String    @unique
  nationalId     String?   @unique
  phone          String?
  email          String?   @unique
  address        String?
  hasPanel       Boolean   @default(false)
  panelCreatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users               User[]
  invoices            Invoice[]
  supportTickets      SupportTicket[]
  activityLogs        ActivityLog[]
  organizationMembers OrganizationMember[]

  @@index([name])
}

enum OrganizationRole {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([role])
}

model BankCard {
  id            String         @id @default(uuid())
  agencyId      String
  cardNumber    String
  bankName      String
  accountHolder String
  sheba         String?
  status        BankCardStatus @default(ACTIVE)
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments Payment[]

  @@unique([agencyId, cardNumber])
  @@index([status])
}

// ============= مدل بلیط (بهبود یافته) =============
model Ticket {
  id              String   @id @default(uuid())
  ticketNumber    String   @unique
  referenceNumber String?
  
  // ===== اطلاعات مسافر =====
  passengerName   String
  passengerPhone  String
  passengerTitle  String?
  nationality     String?
  nationalCode    String?
  passportNumber  String?
  reservationPhone String?
  ageType         AgeType?  // ADT, CHD, INF
  gender          Gender?
  
  // ===== اطلاعات پرواز =====
  flightNumber    String
  departureDate   DateTime  // فقط یک تاریخ (تاریخ حرکت)
  seatClass       String
  route           String?
  segment         String?
  
  // ===== اطلاعات رزرو =====
  pnr             String?
  tourCode        String?
  source          String?
  customerAirline String?
  airlineId       String?   // 🔥 ارتباط با مدل Airline
  sign            String?
  
  // ===== اطلاعات مالی =====
  currencyCode    String   @default("IRR")
  fare            Float    @default(0)
  fee             Float    @default(0)
  tax             Float    @default(0)
  vat             Float    @default(0)
  ancillary       Float    @default(0)
  discount        Float    @default(0)
  price           Float    @default(0) // 🔥 مقدار پیش‌فرض اضافه شد
  
  // ===== کارمزد و مارک‌آپ =====
  commission      Float    @default(0)
  commissionAmount Float   @default(0)
  markup          Float    @default(0)
  
  // ===== فروش و حسابداری =====
  salesType       SalesType @default(STANDARD)
  transactionType TicketTransactionType? // TICKET, CREDIT, REFUND
  transactionDate DateTime?
  referenceNo     String?
  debit           Float?
  credit          Float?
  runningBalance  Float?
  totalRefund     Float?
  
  // ===== فروشنده =====
  agentName       String?
  agentCode       String?
  agentIATACode   String?
  
  // ===== وضعیت =====
  status          TicketStatus @default(DRAFT)
  finalizedAt     DateTime?
  invoiceId       String?
  
  // ===== زمان‌ها =====
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ===== کلیدهای خارجی =====
  agencyId        String
  userId          String

  // ===== روابط =====
  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  airline   Airline?  @relation(fields: [airlineId], references: [id], onDelete: SetNull)
  
  // ===== روابط فرودگاه =====
  originAirportId   String?
  destinationAirportId String?
  originAirport     Airport?  @relation("OriginAirport", fields: [originAirportId], references: [id], onDelete: SetNull)
  destinationAirport Airport? @relation("DestinationAirport", fields: [destinationAirportId], references: [id], onDelete: SetNull)
  
  penalties Penalty[]

  // ===== ایندکس‌ها =====
  @@index([pnr])
  @@index([ticketNumber])
  @@index([referenceNo])
  @@index([nationalCode])
  @@index([departureDate])
  @@index([transactionDate])
  @@index([agentCode])
  @@index([originAirportId])
  @@index([destinationAirportId])
  @@index([status])
  @@index([salesType])
  @@index([agencyId])
  @@index([userId])
  @@index([airlineId])
  @@index([agencyId, status, departureDate]) // 🔥 ترکیبی برای گزارشات
}

// ============= فاکتور =============
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  agencyId       String
  organizationId String?
  customerName   String
  customerPhone  String?
  bankCardId     String?
  templateStyle  Int           @default(1)
  subtotal       Float
  total          Float
  status         InvoiceStatus @default(UNPAID)
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  
  salesType      String        @default("STANDARD")
  currencyCode   String        @default("IRR")
  referenceNo    String?
  transactionType String?
  markup         Float         @default(0)
  debit          Float?
  credit         Float?
  runningBalance Float?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  bankCard     BankCard?     @relation(fields: [bankCardId], references: [id], onDelete: SetNull)
  tickets      Ticket[]
  payments     Payment[]

  @@index([status])
  @@index([issuedAt])
  @@index([referenceNo])
  @@index([agencyId, status])
}

// ============= پرداخت =============
model Payment {
  id              String         @id @default(uuid())
  invoiceId       String
  agencyId        String
  bankCardId      String?
  amount          Float
  paymentMethod   PaymentMethod  @default(CREDIT)
  trackingCode    String?
  receiptNumber   String?
  notes           String?
  currencyCode   String         @default("IRR")
  status          PaymentStatus  @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bankCard BankCard? @relation(fields: [bankCardId], references: [id], onDelete: SetNull)

  cashReceipt CashReceipt?

  @@index([invoiceId])
  @@index([trackingCode])
  @@index([receiptNumber])
  @@index([paidAt])
  @@index([status])
}

// ============= رسید پرداخت نقدی =============
model CashReceipt {
  id              String   @id @default(uuid())
  paymentId       String   @unique
  receiptNumber   String   @unique
  customerName    String
  customerPhone   String?
  ticketNumbers   String[]
  totalAmount     Float
  paidAmount      Float
  remainingAmount Float
  paymentDate     DateTime @default(now())
  printedAt       DateTime?
  printedBy       String?
  notes           String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([receiptNumber])
  @@index([paymentDate])
}

// ============= مدل‌های پشتیبانی =============

model SupportTicket {
  id           String                @id @default(uuid())
  ticketNumber String                @unique
  title        String
  description  String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  senderType   SupportSenderType     @default(USER) // 🔥 Enum شد
  agencyId     String?
  organizationId String?
  userId         String
  parentTicketId String?
  forwardedTo    String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agency       Agency?              @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User                 @relation(fields: [userId], references: [id])
  parentTicket SupportTicket?       @relation("TicketForward", fields: [parentTicketId], references: [id])
  childTickets SupportTicket[]      @relation("TicketForward")
  replies      SupportTicketReply[]

  @@index([agencyId, organizationId])
  @@index([status, priority])
}

model SupportTicketReply {
  id         String   @id @default(uuid())
  ticketId   String
  userId     String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String
  agencyId       String?
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  agency       Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, agencyId, createdAt])
  @@index([entityType, entityId])
}

model Penalty {
  id        String   @id @default(uuid())
  userId    String
  agencyId  String
  points    Int      @default(1)
  reason    String
  ticketId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  agency Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, agencyId])
}

model RegistrationRequest {
  id                 String                    @id @default(uuid())
  agencyName         String
  registrationNumber String?
  contactName        String
  contactPhone       String
  contactEmail       String
  message            String?
  status             RegistrationRequestStatus @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  notes              String?
  agencyId           String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactEmail])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model FailedLoginAttempt {
  id         String   @id @default(uuid())
  email      String
  ipAddress  String?
  userAgent  String?
  attemptedAt DateTime @default(now())

  @@index([email])
  @@index([attemptedAt])
}